# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must always use LF line endings
*.sh text eol=lf

# Dockerfiles should use LF
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf

# Python files
*.py text eol=lf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.env text eol=lf
*.conf text eol=lf

# SQL files
*.sql text eol=lf

